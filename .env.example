# Backup Script Configuration
# Copy to scripts/.env and fill in values

# Site identification
SITE_NAME=example-site

# WordPress paths
APP_PATH=/home/master/applications/example/public_html

# Database credentials
DB_NAME=example_db
DB_USER=example_user
DB_PASS=your_password_here
DB_HOST=localhost

# Cloudflare R2 configuration
R2_BUCKET=pg-backups
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Optional: Heartbeat URL for monitoring
HEARTBEAT_URL=https://your-worker.workers.dev/api/backup-heartbeat

# AWS credentials for R2 (set in ~/.aws/credentials or as env vars)
# AWS_ACCESS_KEY_ID=your_r2_access_key
# AWS_SECRET_ACCESS_KEY=your_r2_secret_key
